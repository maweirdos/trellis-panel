# Read by the deployment process; the service does not load .env automatically.
TEAM_DATA_DIR=/var/lib/trellis-team
TEAM_PUBLIC_ORIGIN=http://127.0.0.1:5441
TEAM_DEPLOYMENT_MODE=local
TEAM_ALLOW_SELF_REGISTRATION=1
# Optional OIDC login, alongside independent local accounts:
# TEAM_OIDC_ISSUER=https://identity.example.internal/realms/company
# TEAM_OIDC_CLIENT_ID=trellis-team
# For a confidential OIDC client using client_secret_basic:
# TEAM_OIDC_CLIENT_SECRET=provide-through-your-secret-manager
# Optional platform administrator, exact configured OIDC issuer subject only:
# TEAM_BOOTSTRAP_SUBJECT=exact-subject-from-the-configured-issuer
TEAM_HOST=127.0.0.1
TEAM_PORT=5441
# Optional compiled supplemental Web client, served at the same public origin:
# TEAM_WEB_DIR=/opt/trellis-team-web/dist
# Never enable this for a non-loopback issuer or public deployment:
# TEAM_ALLOW_LOOPBACK_HTTP=1
# For a self-hosted GitLab OIDC issuer, explicitly match its configured origin:
# TEAM_GITLAB_BASE_URL=https://gitlab.example.internal
# Separate public native OAuth application (loopback callback), never a client secret:
# TEAM_GITLAB_NATIVE_CLIENT_ID=public-native-application-id
# Exact RFC1918 IPv4 HTTP origins only, comma-separated; HTTPS remains the default:
# TEAM_ALLOWED_INTRANET_HTTP_ORIGINS=http://192.168.1.202:8929
# Team content credentials require exactly one external 32-byte base64 encryption key source.
# Supply via a deployment secret; never put the key in the image or commit an actual value.
# TEAM_CONTENT_ENCRYPTION_KEY=
# Or mount an external protected file read-only and set its absolute container path:
# TEAM_CONTENT_ENCRYPTION_KEY_FILE=/run/secrets/team-content-key
# Exact origins for intentionally allowed compatible HTTP providers (including local validation):
# TEAM_CONTENT_ALLOWED_HTTP_ORIGINS=http://127.0.0.1:5442
