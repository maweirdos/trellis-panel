{
  "name": "trellis-panel",
  "version": "0.1.0",
  "description": "Trellis 可视化面板 — Windows 桌面客户端",
  "main": "out/main/index.js",
  "author": "trellis-panel",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "team:local": "node scripts/team-local.mjs",
    "team:build": "node scripts/team-local.mjs --build-only",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:ui": "node scripts/smoke/design-system.mjs",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "generate:collaboration": "node scripts/generate-collaboration-icons.mjs",
    "check:hifox": "node scripts/smoke/hifox-domain.mjs && node scripts/smoke/hifox-roster.mjs --ui && node scripts/smoke/hifox-task-ui.mjs && node scripts/smoke/hifox-workspace-ui.mjs && node scripts/generate-collaboration-icons.mjs --check",
    "check:creations": "node scripts/smoke/creation-desktop.mjs && node scripts/smoke/creation-handoff.mjs && node scripts/smoke/creation-preview.mjs && node scripts/smoke/creation-workspace.mjs",
    "check:hifox:remote": "node scripts/smoke/hifox-remote-client.mjs && node scripts/smoke/hifox-workspace-ipc.mjs && node scripts/smoke/team-gitlab-login.mjs",
    "check:team": "npm run team:build && npm --prefix packages/team-service run typecheck && npm --prefix packages/team-service test && npm --prefix packages/team-web run typecheck && npm --prefix packages/team-web test && node scripts/smoke/hifox-connected.mjs --no-build",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --win",
    "postinstall": "node scripts/prepare-acpx.mjs",
    "check:acpx": "node scripts/check-acpx-compat.mjs",
    "predev": "npm run check:acpx",
    "prebuild": "npm run check:acpx",
    "predist:dir": "npm run check:acpx",
    "predist": "npm run check:acpx",
    "prepare:acpx": "node scripts/prepare-acpx.mjs",
    "pretypecheck": "npm run check:acpx"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "resedit": "1.7.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@gitbeaker/requester-utils": "43.8.0",
    "@gitbeaker/rest": "43.8.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@octokit/rest": "22.0.1",
    "@xyflow/react": "12.12.0",
    "acpx": "0.19.5",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.469.0",
    "mermaid": "^11.17.2",
    "oauth4webapi": "3.8.8",
    "patch-package": "8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "undici": "^8.11.0",
    "zod": "^4.6.5",
    "zustand": "^4.5.5"
  },
  "overrides": {
    "acpx": {
      "@agentclientprotocol/sdk": "1.8.0"
    }
  }
}
