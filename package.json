{
  "name": "trellis-panel",
  "version": "0.1.0",
  "description": "Trellis 可视化面板 — Windows 桌面客户端",
  "main": "out/main/index.js",
  "author": "trellis-panel",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "team:local": "node scripts/team-local.mjs",
    "team:build": "node scripts/team-local.mjs --build-only",
    "daemon:status": "node scripts/daemon-dev-cli.mjs status",
    "daemon:stop": "node scripts/daemon-dev-cli.mjs stop",
    "daemon:restart": "node scripts/daemon-dev-cli.mjs restart",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:ui": "node scripts/check-design-system.mjs",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "generate:collaboration": "node scripts/generate-collaboration-icons.mjs",
    "dist:dir": "electron-vite build && node scripts/prepare-pi-runtime.mjs && node scripts/package-desktop.mjs --dir",
    "dist": "electron-vite build && node scripts/prepare-pi-runtime.mjs && node scripts/package-desktop.mjs",
    "postinstall": "npm run check:acpx && node scripts/prepare-pi-tools.mjs",
    "check:acpx": "node scripts/check-acp-v2.mjs",
    "predev": "npm run check:acpx && node scripts/prepare-pi-tools.mjs",
    "prebuild": "npm run check:acpx && node scripts/prepare-pi-tools.mjs && node scripts/prepare-team-trellis.mjs",
    "predist:dir": "npm run check:acpx && node scripts/prepare-node-runtime.mjs",
    "predist": "npm run check:acpx && node scripts/prepare-node-runtime.mjs",
    "prepare:pi-tools": "node scripts/prepare-pi-tools.mjs",
    "pretypecheck": "npm run check:acpx"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.3",
    "electron-builder": "26.0.11",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "postcss": "^8.4.49",
    "resedit": "1.7.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@floating-ui/dom": "1.8.0",
    "@gitbeaker/requester-utils": "43.8.0",
    "@gitbeaker/rest": "43.8.0",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@octokit/rest": "22.0.1",
    "@opencode/client": "2.0.28",
    "@opencode/protocol": "2.0.28",
    "@opencode/schema": "2.0.28",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@xyflow/react": "12.12.0",
    "@zip.js/zip.js": "2.24.0",
    "effect": "4.1.5",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "css-tree": "3.1.0",
    "csv-parse": "7.0.3",
    "diff": "^9.0.0",
    "dingtalk-stream": "2.1.5",
    "dompurify": "3.4.17",
    "electron-updater": "^6.8.9",
    "fflate": "0.8.3",
    "https-proxy-agent": "7.0.6",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.469.0",
    "mammoth": "1.13.0",
    "marked": "17.0.6",
    "mermaid": "^11.17.2",
    "oauth4webapi": "3.8.8",
    "parse5": "8.0.0",
    "pdfjs-dist": "6.5.438",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "socks-proxy-agent": "8.0.5",
    "undici": "^8.11.0",
    "zod": "^4.6.5",
    "zustand": "^4.5.5"
  },
  "overrides": {
    "@opencode/client@2.0.28": { "effect": "$effect" },
    "@opencode/protocol@2.0.28": { "effect": "$effect" },
    "@opencode/schema@2.0.28": { "effect": "$effect" }
  }
}
